<Layouts.auth_card
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  title={gettext("Log in")}
>
  <:subtitle>
    <%= if @current_scope do %>
      {gettext("You need to reauthenticate to perform sensitive actions on your account.")}
    <% else %>
      {gettext("Don't have an account?")}
      <.link navigate={~p"/users/register"} class="text-red-600 font-semibold hover:underline">
        {gettext("Sign up")}
      </.link>
      {gettext("for an account now.")}
    <% end %>
  </:subtitle>

  <!-- Email + Password login -->
  <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
    <Layouts.auth_input
      field={f[:email]}
      type="email"
      label={gettext("Email")}
      readonly={!!@current_scope}
      autocomplete="email"
      required
    />
    <Layouts.auth_input
      field={f[:password]}
      type="password"
      label={gettext("Password")}
      wrapper_class="mb-6"
      autocomplete="current-password"
      required
    />
    <button
      type="submit"
      name={@form[:remember_me].name}
      value="true"
      class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg flex items-center justify-center gap-2 mb-3"
    >
      {gettext("Log in and stay logged in")} <span aria-hidden="true">→</span>
    </button>
    <button
      type="submit"
      class="w-full bg-white text-gray-700 px-6 py-3 rounded-full font-semibold hover:bg-gray-50 transition border border-gray-200"
    >
      {gettext("Log in only this time")}
    </button>
  </.form>
</Layouts.auth_card>
