<Layouts.auth_card
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  title={"#{gettext("Welcome")} #{@user.email}"}
>
  <:subtitle :if={!@user.confirmed_at}>
    {gettext("Set your password to complete registration.")}
  </:subtitle>
  <:subtitle :if={@user.confirmed_at}>
    {gettext("Your account is confirmed. Click below to log in.")}
  </:subtitle>

  <.form
    :if={!@user.confirmed_at}
    for={@form}
    id="confirmation_form"
    action={~p"/users/log-in?_action=confirmed"}
    phx-mounted={JS.focus_first()}
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

    <Layouts.auth_input
      field={@form[:password]}
      type="password"
      label={gettext("Password")}
      autocomplete="new-password"
      required
    />
    <Layouts.auth_input
      field={@form[:password_confirmation]}
      type="password"
      label={gettext("Confirm password")}
      wrapper_class="mb-6"
      autocomplete="new-password"
      required
    />

    <button
      type="submit"
      name={@form[:remember_me].name}
      value="true"
      phx-disable-with={gettext("Creating account...")}
      class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg flex items-center justify-center gap-2 mb-3"
    >
      {gettext("Complete registration")} <span aria-hidden="true">→</span>
    </button>
  </.form>

  <.form
    :if={@user.confirmed_at}
    for={@form}
    id="login_form"
    action={~p"/users/log-in"}
    phx-mounted={JS.focus_first()}
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
    <%= if @current_scope do %>
      <button
        type="submit"
        phx-disable-with={gettext("Logging in...")}
        class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg"
      >
        {gettext("Log in")}
      </button>
    <% else %>
      <button
        type="submit"
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with={gettext("Logging in...")}
        class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg flex items-center justify-center gap-2 mb-3"
      >
        {gettext("Keep me logged in on this device")} <span aria-hidden="true">→</span>
      </button>
      <button
        type="submit"
        phx-disable-with={gettext("Logging in...")}
        class="w-full bg-white text-gray-700 px-6 py-3 rounded-full font-semibold hover:bg-gray-50 transition border border-gray-200"
      >
        {gettext("Log me in only this time")}
      </button>
    <% end %>
  </.form>
</Layouts.auth_card>
