<Layouts.top_nav current_scope={@current_scope} locale={@locale} />

<div class="min-h-screen bg-gradient-to-b from-gray-50 via-white to-gray-100 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Card Container -->
    <div class="bg-white rounded-3xl shadow-2xl p-8 border border-gray-100">
      <Layouts.flash_group flash={@flash} />

      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">
          {gettext("Register for an account")}
        </h1>
        <p class="text-gray-600">
          {gettext("Already registered?")}
          <.link navigate={~p"/users/log-in"} class="text-red-600 font-semibold hover:underline">
            {gettext("Log in")}
          </.link>
          {gettext("to your account now.")}
        </p>
      </div>

      <.form :let={f} for={@changeset} action={~p"/users/register"}>
        <div class="mb-6">
          <label class="block text-gray-700 font-medium mb-2">{gettext("Email")}</label>
          <input
            type="email"
            name={f[:email].name}
            value={Phoenix.HTML.Form.normalize_value("email", f[:email].value)}
            autocomplete="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-red-500 focus:ring-2 focus:ring-red-100 transition outline-none"
          />
          <.error :for={msg <- f[:email].errors}>{translate_error(msg)}</.error>
        </div>

        <button
          type="submit"
          class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg"
        >
          {gettext("Create an account")}
        </button>
      </.form>
    </div>
  </div>
</div>
