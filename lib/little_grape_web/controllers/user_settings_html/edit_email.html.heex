<Layouts.settings_card
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  title={gettext("Change Email")}
  subtitle={gettext("Update your email address")}
  link_href={~p"/users/settings/password"}
  link_text={gettext("Change Password instead")}
>
  <.form :let={f} for={@email_changeset} action={~p"/users/settings/email"} id="update_email">
    <Layouts.auth_input
      field={f[:email]}
      type="email"
      label={gettext("New Email")}
      autocomplete="email"
      required
    />
    <button
      type="submit"
      class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg"
    >
      {gettext("Change Email")}
    </button>
  </.form>
</Layouts.settings_card>
