<Layouts.settings_card
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  title={gettext("Change Password")}
  subtitle={gettext("Update your password")}
  link_href={~p"/users/settings/email"}
  link_text={gettext("Change Email instead")}
>
  <.form
    :let={f}
    for={@password_changeset}
    action={~p"/users/settings/password"}
    id="update_password"
  >
    <Layouts.auth_input
      field={f[:password]}
      type="password"
      label={gettext("New password")}
      autocomplete="new-password"
      required
    />
    <Layouts.auth_input
      field={f[:password_confirmation]}
      type="password"
      label={gettext("Confirm new password")}
      wrapper_class="mb-6"
      autocomplete="new-password"
      required
    />
    <button
      type="submit"
      class="w-full bg-red-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-red-700 transition shadow-lg"
    >
      {gettext("Save Password")}
    </button>
  </.form>
</Layouts.settings_card>
